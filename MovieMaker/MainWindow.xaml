<Window x:Class="MovieMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MovieMaker"
        xmlns:styles="clr-namespace:MovieMaker.Styles"
        xmlns:resx="clr-namespace:MovieMaker.Resources"
        xmlns:conv="clr-namespace:MovieMaker.Converters"
        xmlns:views="clr-namespace:MovieMaker.Views"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        MinHeight="{x:Static styles:LayoutConstants.WindowMinHeight}"
        MinWidth="{x:Static styles:LayoutConstants.WindowMinWidth}"
        FontFamily="{x:Static styles:LayoutConstants.DefaultFontFamily}">
    <Window.Resources>
        <conv:AppModeVisibilityConverter x:Key="AppModeVisibilityConverter" />
        <conv:ModeToggleLabelConverter x:Key="ModeToggleLabelConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
    </Window.InputBindings>
    <Grid Margin="{x:Static styles:LayoutConstants.RootMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上部 : モード切替。 -->
        <DockPanel Grid.Row="0" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <Button DockPanel.Dock="Right" Content="{Binding Mode, Converter={StaticResource ModeToggleLabelConverter}}"
                    Command="{Binding ToggleModeCommand}" />
        </DockPanel>

        <!-- 下部 : 作成モード/再生モードの画面を、モードに応じて切り替える。 -->
        <Grid Grid.Row="1">
            <views:CreateModeView Visibility="{Binding Mode, Converter={StaticResource AppModeVisibilityConverter}, ConverterParameter=Create}" />
            <views:PlayModeView Visibility="{Binding Mode, Converter={StaticResource AppModeVisibilityConverter}, ConverterParameter=Play}" />
        </Grid>
    </Grid>
</Window>
