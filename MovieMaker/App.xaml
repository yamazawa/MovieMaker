<Application x:Class="MovieMaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MovieMaker"
             xmlns:conv="clr-namespace:MovieMaker.Converters">
    <Application.Resources>
        <!--
            WindowStyle/WindowStateはMainWindow自身の属性でConverterを参照するため、
            Window.Resourcesに置くとXAML解析順序の都合でリソースが見つからず例外になる。
            そのためWindow構築前に読み込まれるApplication.Resourcesに置く。
        -->
        <conv:FullScreenWindowStyleConverter x:Key="FullScreenWindowStyleConverter" />
        <conv:FullScreenWindowStateConverter x:Key="FullScreenWindowStateConverter" />
    </Application.Resources>
</Application>
