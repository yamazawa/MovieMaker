<UserControl x:Class="MovieMaker.Views.PlayModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:MovieMaker.Styles"
             xmlns:conv="clr-namespace:MovieMaker.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    </UserControl.Resources>
    <!-- キャンバスのみをフル表示する。ループ再生の本実装・配置オブジェクトの表示はタスク7で追加する。 -->
    <Viewbox Stretch="Uniform">
        <Border Width="{x:Static styles:LayoutConstants.CanvasWidth}" Height="{x:Static styles:LayoutConstants.CanvasHeight}"
                Background="{Binding BackgroundColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
    </Viewbox>
</UserControl>
