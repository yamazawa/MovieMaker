<UserControl x:Class="MovieMaker.Views.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:MovieMaker.Styles"
             xmlns:conv="clr-namespace:MovieMaker.Converters"
             xmlns:behaviors="clr-namespace:MovieMaker.Behaviors"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:SecondsToPixelsConverter x:Key="SecondsToPixelsConverter" />
        <conv:AlternationIndexToRowTopConverter x:Key="AlternationIndexToRowTopConverter" />

        <!-- オブジェクトごとに1行を割り当て、重ならないよう縦に積む。 -->
        <Style x:Key="BarContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding StartTime, Converter={StaticResource SecondsToPixelsConverter}}" />
            <Setter Property="Canvas.Top"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexToRowTopConverter}}" />
        </Style>

        <DataTemplate x:Key="BarTemplate">
            <Border Width="{Binding DurationSeconds, Converter={StaticResource SecondsToPixelsConverter}}"
                    Height="{x:Static styles:LayoutConstants.TimelineRowHeight}"
                    Background="SteelBlue" CornerRadius="2" IsHitTestVisible="False" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- DataContextはMainViewModelをそのまま継承する(このControl専用のDependencyPropertyは持たない)。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Canvas Width="{Binding Duration, Converter={StaticResource SecondsToPixelsConverter}}"
                Background="Transparent"
                behaviors:TimelineScrubBehavior.IsEnabled="True"
                behaviors:TimelineScrubBehavior.CurrentTime="{Binding CurrentTime, Mode=TwoWay}"
                behaviors:TimelineScrubBehavior.Duration="{Binding Duration}">
            <ItemsControl ItemsSource="{Binding Objects}" ItemTemplate="{StaticResource BarTemplate}"
                          ItemContainerStyle="{StaticResource BarContainerStyle}" AlternationCount="1000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- 現在の再生位置を示す縦線。 -->
            <Border Width="2" Background="Red" IsHitTestVisible="False"
                    Height="{x:Static styles:LayoutConstants.TimelineHeight}"
                    Canvas.Left="{Binding CurrentTime, Converter={StaticResource SecondsToPixelsConverter}}" />
        </Canvas>
    </ScrollViewer>
</UserControl>
