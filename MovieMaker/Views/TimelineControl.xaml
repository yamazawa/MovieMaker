<UserControl x:Class="MovieMaker.Views.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:MovieMaker.Styles"
             xmlns:resx="clr-namespace:MovieMaker.Resources"
             xmlns:conv="clr-namespace:MovieMaker.Converters"
             xmlns:behaviors="clr-namespace:MovieMaker.Behaviors"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:MultiplyConverter x:Key="MultiplyConverter" />
        <conv:AlignStateBrushConverter x:Key="AlignStateBrushConverter" />
        <conv:SceneObjectTypeBrushConverter x:Key="SceneObjectTypeBrushConverter" />

        <!--
            タイムチャート内のオブジェクトの表示順はMainViewModel.Objectsの並び順そのもの。
            バー本体の縦ドラッグ、または「並べ替え」ボタン(SortObjectsCommand)で順序を変更する。
        -->

        <!-- オブジェクトごとに1行を割り当て、重ならないよう縦に積む。行の高さは縦方向の拡縮に応じて変わる。 -->
        <Style x:Key="BarContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource MultiplyConverter}">
                        <Binding Path="StartTime" />
                        <Binding Path="DataContext.TimelinePixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Canvas.Top">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource MultiplyConverter}">
                        <Binding RelativeSource="{RelativeSource Self}" Path="(ItemsControl.AlternationIndex)" />
                        <Binding Path="DataContext.TimelineRowHeight" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- クリックで選択、バー本体のドラッグで長さを保ったまま左右移動、左右端のドラッグで表示開始/終了時刻を編集できる(いずれも1秒単位)。 -->
        <DataTemplate x:Key="BarTemplate">
            <Border Height="{Binding DataContext.TimelineRowHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{Binding Type, Converter={StaticResource SceneObjectTypeBrushConverter}}"
                    CornerRadius="2" Cursor="SizeWE" BorderThickness="2"
                    behaviors:SelectOnClickBehavior.Command="{Binding DataContext.SelectTimelineObjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    behaviors:TimelineBarMoveBehavior.IsEnabled="True">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource AlignStateBrushConverter}">
                        <Binding Path="IsSelected" />
                        <Binding Path="IsAlignTarget" />
                    </MultiBinding>
                </Border.BorderBrush>
                <Border.Width>
                    <MultiBinding Converter="{StaticResource MultiplyConverter}">
                        <Binding Path="DurationSeconds" />
                        <Binding Path="DataContext.TimelinePixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Border.Width>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Static styles:LayoutConstants.TimelineEdgeHandleGridLength}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{x:Static styles:LayoutConstants.TimelineEdgeHandleGridLength}" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="Transparent" Cursor="SizeWE" behaviors:TimelineEdgeDragBehavior.Edge="Start" />
                    <Rectangle Grid.Column="2" Fill="Transparent" Cursor="SizeWE" behaviors:TimelineEdgeDragBehavior.Edge="End" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- DataContextはMainViewModelをそのまま継承する(このControl専用のDependencyPropertyは持たない)。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 拡縮(ズーム)。横:秒あたりpx数、縦:1行の高さ。 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{x:Static resx:Strings.Label_TimelineZoomX}" VerticalAlignment="Center" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <Slider Width="120" VerticalAlignment="Center"
                    Minimum="{x:Static styles:LayoutConstants.TimelineZoomXMin}" Maximum="{x:Static styles:LayoutConstants.TimelineZoomXMax}"
                    Value="{Binding TimelinePixelsPerSecond}" />
            <TextBlock Text="{x:Static resx:Strings.Label_TimelineZoomY}" VerticalAlignment="Center" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <Slider Width="120" VerticalAlignment="Center"
                    Minimum="{x:Static styles:LayoutConstants.TimelineZoomYMin}" Maximum="{x:Static styles:LayoutConstants.TimelineZoomYMax}"
                    Value="{Binding TimelineRowHeight}" />
            <Button Content="{x:Static resx:Strings.Button_SortObjects}" VerticalAlignment="Center"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" Command="{Binding SortObjectsCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
            <Canvas Background="Transparent"
                    behaviors:TimelineScrubBehavior.IsEnabled="True"
                    behaviors:TimelineScrubBehavior.CurrentTime="{Binding CurrentTime, Mode=TwoWay}"
                    behaviors:TimelineScrubBehavior.Duration="{Binding Duration}"
                    behaviors:TimelineScrubBehavior.PixelsPerSecond="{Binding TimelinePixelsPerSecond}">
                <Canvas.Width>
                    <MultiBinding Converter="{StaticResource MultiplyConverter}">
                        <Binding Path="Duration" />
                        <Binding Path="TimelinePixelsPerSecond" />
                    </MultiBinding>
                </Canvas.Width>
                <Canvas.Height>
                    <MultiBinding Converter="{StaticResource MultiplyConverter}">
                        <Binding Path="Objects.Count" />
                        <Binding Path="TimelineRowHeight" />
                    </MultiBinding>
                </Canvas.Height>

                <ItemsControl ItemsSource="{Binding Objects}" ItemTemplate="{StaticResource BarTemplate}"
                              ItemContainerStyle="{StaticResource BarContainerStyle}" AlternationCount="1000">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 現在の再生位置を示す縦線。 -->
                <Border Width="2" Background="Red" IsHitTestVisible="False">
                    <Border.Height>
                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                            <Binding Path="Objects.Count" />
                            <Binding Path="TimelineRowHeight" />
                        </MultiBinding>
                    </Border.Height>
                    <Canvas.Left>
                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                            <Binding Path="CurrentTime" />
                            <Binding Path="TimelinePixelsPerSecond" />
                        </MultiBinding>
                    </Canvas.Left>
                </Border>
            </Canvas>
        </ScrollViewer>
    </Grid>
</UserControl>
