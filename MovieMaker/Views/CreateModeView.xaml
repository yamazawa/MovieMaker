<UserControl x:Class="MovieMaker.Views.CreateModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:MovieMaker.Styles"
             xmlns:resx="clr-namespace:MovieMaker.Resources"
             xmlns:conv="clr-namespace:MovieMaker.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{x:Static styles:LayoutConstants.TimelineHeightGridLength}" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static styles:LayoutConstants.PaletteWidthGridLength}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左 : 編集パレット。オブジェクトの追加・選択中オブジェクトの編集項目はタスク2以降で追加する。 -->
            <DockPanel Grid.Column="0" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static resx:Strings.Header_Palette}"
                           FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            </DockPanel>

            <!-- 中央 : キャンバス(動画本体)。配置済みオブジェクトの表示はタスク2以降で追加する。 -->
            <Viewbox Grid.Column="1" Stretch="Uniform" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
                <Border Width="{x:Static styles:LayoutConstants.CanvasWidth}" Height="{x:Static styles:LayoutConstants.CanvasHeight}"
                        Background="{Binding BackgroundColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
            </Viewbox>
        </Grid>

        <!-- 下部 : タイムライン。スライドバー兼タイミングチャートの本実装はタスク5で追加する。 -->
        <Border Grid.Row="1" Margin="{x:Static styles:LayoutConstants.SectionSpacing}" BorderThickness="1" BorderBrush="Gray" />
    </Grid>
</UserControl>
